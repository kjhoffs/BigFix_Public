<?xml version="1.0" encoding="UTF-8"?>
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
	<Task>
		<Title>Move Existing Client Setting to New Client Setting</Title>
		<Description><![CDATA[<P>This will be relevan if "OldClientSetting" exists and has a value<BR><BR>It will </P>
<UL>
<LI>Copy the value from "OldClientSetting" to "NewClientSetting" 
<LI>Validate the values match between the two settings 
<LI>Delete the "OldClientSetting"</LI></UL>]]></Description>
		<Relevance>exists values of settings "OldClientSetting" of client</Relevance>
		<Category></Category>
		<Source>Internal</Source>
		<SourceID></SourceID>
		<SourceReleaseDate>2026-05-08</SourceReleaseDate>
		<SourceSeverity></SourceSeverity>
		<CVENames></CVENames>
		<SANSID></SANSID>
		<MIMEField>
			<Name>x-fixlet-modification-time</Name>
			<Value>Fri, 08 May 2026 21:17:31 +0000</Value>
		</MIMEField>
		<Domain>BESC</Domain>
		<DefaultAction ID="Action1">
			<Description>
				<PreLink>Click </PreLink>
				<Link>here</Link>
				<PostLink> to deploy this action.</PostLink>
			</Description>
			<ActionScript MIMEType="application/x-Fixlet-Windows-Shell">// 1. Capture the current value of "OldClientSetting" into a parameter
parameter "OldClientSettingValue" = "{value of settings "OldClientSetting" of client | ""}"

// 2. Create/Update "NewClientSetting" with that captured value
setting "NewClientSetting"="{parameter "OldClientSettingValue"}" on "{now}" for client

// 3. Validate the copy and delete "OldClientSetting"
// We use a continue if to ensure "NewClientSetting" actually matches our parameter before deleting the original
continue if {value of setting "NewClientSetting" of client = parameter "OldClientSettingValue"}

// 4. Delete the original "OldClientSetting" setting
setting delete "OldClientSetting" on "{now}" for client</ActionScript>
		</DefaultAction>
	</Task>
</BES>
